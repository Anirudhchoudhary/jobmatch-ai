{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudFrontReadOnly",
      "Effect": "Allow",
      "Principal": {"Service": "cloudfront.amazonaws.com"},
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__SITE_BUCKET__/*",
      "Condition": {"StringEquals": {"AWS:SourceArn": "__DISTRIBUTION_ARN__"}}
    }
  ]
}
